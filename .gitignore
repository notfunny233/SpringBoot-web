# 编译产物。每编译一次就会变，提交上去仓库会一直膨胀。
target/
build/
out/
*.class
*.jar
*.war

# 依赖包。有 package-lock.json 就够还原了，不用存这 200M 的东西。
node_modules/

# 前端打包结果
dist/
dist-ssr/

# IDE 本地配置。跟机器和本机路径绑定，换台电脑就没用了。
.idea/
*.iml
*.iws

# 本地个人配置
*.local

# 日志
*.log
logs/

# AI 助手的工作目录。里面是记忆笔记和临时产物，跟项目代码无关。
.workbuddy/

# 系统生成的文件
.DS_Store
Thumbs.db
